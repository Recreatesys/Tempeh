<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Action on contacts / the 催款報表 list: select customers ->
             Action -> Print Customer Statements (handles multiple at once). -->
        <record id="action_open_customer_statement_wizard_server" model="ir.actions.server">
            <field name="name">Print Customer Statements</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = {
        'name': '客戶月結單',
        'type': 'ir.actions.act_window',
        'res_model': 'customer.statement.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {'default_partner_ids': [(6, 0, records.ids)]},
    }
            </field>
        </record>

        <!-- 催款報表: list of customers with outstanding AR. Tick several and use
             Action -> Print Customer Statements to print statements together. -->
        <record id="view_followup_customers_list" model="ir.ui.view">
            <field name="name">followup.customers.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="催款報表" create="0" import="0">
                    <field name="currency_id" column_invisible="1"/>
                    <field name="name"/>
                    <field name="ref" optional="show"/>
                    <field name="followup_status" widget="badge"
                           decoration-danger="followup_status == 'in_need_of_action'"
                           decoration-warning="followup_status == 'with_overdue_invoices'"
                           decoration-info="followup_status == 'no_action_needed'"/>
                    <field name="followup_responsible_id" optional="hide" widget="many2one_avatar_user"/>
                    <field name="total_due" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="total_overdue" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </list>
            </field>
        </record>

        <!-- Per-customer 催款報表 form: lists the customer's outstanding invoices
             (like the native follow-up detail) with a Print Statement button. -->
        <record id="view_followup_customer_form" model="ir.ui.view">
            <field name="name">followup.customer.statement.form</field>
            <field name="model">res.partner</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <form string="催款報表" create="0">
                    <header>
                        <button name="action_manually_process_automatic_followups" type="object"
                                string="跟進 Follow-up" class="btn-primary"/>
                        <button name="action_open_unreconciled_partner" type="object"
                                string="對賬 Reconcile"/>
                        <button name="action_print_customer_statement" type="object"
                                string="列印月結單 Print Statement"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_partner_form" type="object"
                                    class="oe_stat_button" icon="fa-address-card">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">客戶</span>
                                    <span class="o_stat_text">Customer</span>
                                </div>
                            </button>
                            <button name="action_view_unpaid_invoices" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o">
                                <field name="unpaid_invoices_count" widget="statinfo"
                                       string="發票 Invoices"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                            <h3><field name="followup_line_id" readonly="1"
                                       string="催款等級" placeholder="催款等級 Follow-up Level"/></h3>
                        </div>
                        <group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="ref" string="參考" readonly="1"/>
                                <field name="followup_status" string="跟進狀態" widget="badge" readonly="1"
                                       decoration-danger="followup_status == 'in_need_of_action'"
                                       decoration-warning="followup_status == 'with_overdue_invoices'"
                                       decoration-success="followup_status == 'no_action_needed'"/>
                                <field name="followup_reminder_type" string="提醒" readonly="1"/>
                            </group>
                            <group>
                                <field name="followup_next_action_date" string="下次跟進日" readonly="1"/>
                                <field name="followup_responsible_id" string="負責人" readonly="1"
                                       widget="many2one_avatar_user"/>
                                <field name="credit" string="總欠款 Total Receivable"
                                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_overdue" string="逾期總額"
                                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </group>
                        <separator string="未付發票 Outstanding Invoices"/>
                        <field name="statement_move_line_ids">
                            <list create="0" delete="0" editable="bottom">
                                <field name="company_currency_id" column_invisible="1"/>
                                <field name="date" string="日期" readonly="1"/>
                                <field name="move_id" string="編號" readonly="1"/>
                                <field name="invoice_origin" string="原始" readonly="1" optional="show"/>
                                <field name="date_maturity" string="到期繳付日" readonly="1"/>
                                <field name="statement_delivery_date" string="預計交貨日期"
                                       readonly="1" optional="show"/>
                                <field name="statement_excluded" string="不納入後續行動"
                                       widget="boolean_toggle"/>
                                <field name="amount_residual" string="殘值金額"
                                       widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_followup_customers_list" model="ir.actions.act_window">
            <field name="name">催款報表</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_followup_customers_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_followup_customer_form')})]"/>
            <field name="domain">[('credit', '>', 0)]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No customers with outstanding receivables.</p>
            </field>
        </record>

        <menuitem id="menu_account_followup_report"
                  name="催款報表"
                  parent="account.menu_finance_receivables"
                  action="action_followup_customers_list"
                  groups="account.group_account_invoice"
                  sequence="11"/>
    </data>
</odoo>
