<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Action on contacts / Follow-up customer list:
             select customers -> Action -> Print Customer Statements -->
        <record id="action_open_customer_statement_wizard_server" model="ir.actions.server">
            <field name="name">Print Customer Statements</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = {
        'name': '客戶月結單',
        'type': 'ir.actions.act_window',
        'res_model': 'customer.statement.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {'default_partner_ids': [(6, 0, records.ids)]},
    }
            </field>
        </record>

        <!-- Expose the native Follow-up Reports (催款報表) screen in Accounting → Customers -->
        <menuitem id="menu_account_followup_report"
                  name="Follow-up Reports"
                  parent="account.menu_finance_receivables"
                  action="account_followup.action_account_followup"
                  groups="account.group_account_invoice"
                  sequence="11"/>
    </data>
</odoo>
