<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 2026 Hong Kong STATUTORY holidays (15). These are the general holidays
         EXCEPT Good Friday and the day following Good Friday, which only become
         statutory in 2028 and 2030 respectively under the phased increase to 17.
         Note: employers may substitute the Winter Solstice (22 Dec 2026) for
         Christmas Day at their option — adjust if that is the company policy.
         Times are naive full-day; refine for Asia/Hong_Kong (UTC+8) if needed. -->

