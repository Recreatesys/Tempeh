<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hrm_hk_lieu_list" model="ir.ui.view">
        <field name="name">hrm.hk.holiday.lieu.list</field>
        <field name="model">hrm.hk.holiday.lieu</field>
        <field name="arch" type="xml">
            <list string="Days Off in Lieu" decoration-success="state == 'granted'"
                  decoration-muted="state == 'cancelled'">
                <field name="employee_id"/>
                <field name="holiday_date"/>
                <field name="holiday_name"/>
                <field name="days" sum="Total"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'granted'"/>
                <button name="action_grant" type="object" string="Grant" icon="fa-check"
                        invisible="state != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_hrm_hk_lieu_form" model="ir.ui.view">
        <field name="name">hrm.hk.holiday.lieu.form</field>
        <field name="model">hrm.hk.holiday.lieu</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_grant" type="object" string="Grant Day Off in Lieu"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'granted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,granted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="holiday_date"/>
                            <field name="holiday_name" placeholder="e.g. Tuen Ng Festival"/>
                        </group>
                        <group>
                            <field name="days"/>
                            <field name="expiry_date"/>
                            <field name="allocation_id" readonly="1"
                                   invisible="not allocation_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hrm_hk_lieu_search" model="ir.ui.view">
        <field name="name">hrm.hk.holiday.lieu.search</field>
        <field name="model">hrm.hk.holiday.lieu</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="to_grant" string="To Grant" domain="[('state','=','draft')]"/>
                <filter name="granted" string="Granted" domain="[('state','=','granted')]"/>
                <group>
                    <filter name="grp_emp" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="grp_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hrm_hk_lieu" model="ir.actions.act_window">
        <field name="name">Days Off in Lieu</field>
        <field name="res_model">hrm.hk.holiday.lieu</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hrm_hk_lieu_search"/>
    </record>

    <menuitem id="menu_hrm_hk_lieu" name="Days Off in Lieu"
              parent="hr.menu_hr_root" action="action_hrm_hk_lieu"
              groups="hr.group_hr_user" sequence="8"/>
</odoo>
