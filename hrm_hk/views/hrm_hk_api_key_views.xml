<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hrm_hk_api_key_list" model="ir.ui.view">
        <field name="name">hrm.hk.api.key.list</field>
        <field name="model">hrm.hk.api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_preview"/>
                <field name="scope"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hrm_hk_api_key_form" model="ir.ui.view">
        <field name="name">hrm.hk.api.key.form</field>
        <field name="model">hrm.hk.api.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_key" type="object" string="Generate Key"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="scope"/>
                        <field name="key_preview" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        The raw key is shown only once, when generated. Store it in the
                        Next.js server environment (never in the browser bundle).
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hrm_hk_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">hrm.hk.api.key</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
